{
  "name": "kurabellplus-ios",
  "private": true,
  "version": "1.0.0",
  "description": "KURABELL Workout Log iOS wrapper (Capacitor)",
  "scripts": {
    "sync-www": "node scripts/sync-www.js",
    "ios:add": "npm run sync-www && npx cap add ios",
    "ios:sync": "npm run sync-www && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "test": "vitest run"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4"
  }
}
