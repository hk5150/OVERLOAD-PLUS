.claude/settings.local.json

# エディタの個人設定(このMac上の他プロジェクトへのパスを含むため共有しない)
*.code-workspace

# iOSラッパー(Capacitor)のビルド生成物
node_modules/
www/

# UI検証時のスクリーンショット・コンソールログ(Playwright MCPが吐く作業用の生成物)
.playwright-mcp/
.claude/locks/
.locks/

# App Store Connect の API キー(リポジトリに入れない。置き場所は ~/.appstoreconnect/private_keys/)
*.p8
__pycache__/

# YouTube の長い紹介動画の出来上がり(動画の置き場は marketing/youtube-long/、git には入れない)
marketing/youtube-long/*.mp4
