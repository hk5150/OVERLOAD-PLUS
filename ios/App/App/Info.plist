<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>KURABELL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- 対応言語の宣言。UIはWebView側(src/domain/i18n.js)で切り替えるが、
	     これを書かないとApp Storeの製品ページに「言語: 英語」しか出ず、日本語対応が伝わらない。
	     アプリ名 KURABELL は言語によらない。OSが出す権限ダイアログの文言(NSHealth*UsageDescription)
	     だけは WebView の外なので、日本語訳を ja.lproj/InfoPlist.strings に置いている。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ヘルスケア連携の権限ダイアログの文言(英語。日本語は ja.lproj/InfoPlist.strings)。docs/ヘルスケア連携.md -->
	<key>NSHealthShareUsageDescription</key>
	<string>KURABELL reads your latest body weight from Health to calculate bodyweight exercises. If the app is on your Apple Watch, it also reads heart rate and active energy during the workout you record on the watch.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>KURABELL saves your workouts and the body weight you enter to Health. Workouts recorded on Apple Watch include heart rate and active energy.</string>
	<!-- 休憩タイマーのLive Activity(拡張RestActivity)。docs/休憩タイマー通知.md -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- UIScene のライフサイクル。iOS 27 SDK(Xcode 27)でビルドしたアプリは、これが無いと iOS 27 の端末で
	     起動時に UIKit に止められる(1.1.1 (11) の実機で踏んだ。docs/Watchアプリ.md)。
	     ウィンドウと最初の画面は SceneDelegate.swift がコードで作るので、Main.storyboard は使わない。 -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<!-- AppDelegate.swift の configurationForConnecting が返す名前と同じにしておく -->
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- 標準のHTTPS/TLS以外の独自暗号化は使っていないため輸出コンプライアンス対象外。
	     これが無いと提出のたびにApp Store Connectで手動回答が必要になる。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
