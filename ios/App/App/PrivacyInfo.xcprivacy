<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- トラッキングも外部送信も行わない。記録は端末内のみ(privacy.html と同じ内容)。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- @capacitor/preferences が UserDefaults を使う(Preferences.swift)。
		     UserDefaults は Required Reason API なので理由の宣言が必須。
		     CA92.1 = 自アプリからのみアクセスできる情報の読み書き(他アプリと共有しない)。
		     Capacitor本体のマニフェストは NSPrivacyAccessedAPITypes が空で、
		     @capacitor/preferences はマニフェストを同梱していないため、アプリ側で宣言する。 -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- @capacitor-community/sqlite (SQLite本体)がDB/ジャーナルファイルの入出力でファイル
		     タイムスタンプ系API(stat/fstat等)を内部的に使う。プラグイン自体はPrivacy Manifestを
		     同梱していない(ios/以下にxcprivacyが無いことを確認済み)ため、アプリ側で宣言する。
		     C617.1 = 自アプリのコンテナ内(App Group/CloudKitコンテナ含む)にあるファイルの
		     タイムスタンプへのアクセス。DBファイルはLibrary/CapacitorDatabase(アプリのコンテナ内)
		     に置いており、ユーザーが選んだ外部ファイルではないためC617.1が該当する。
		     ※ Xcodeでのビルド(Privacy Report)による実機確認はまだ行っていない。 -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
